[Unit]
Description=Mattermost <-> claude-app-server bridge
Wants=claude-app-server.service
After=claude-app-server.service network-online.target

[Service]
# systemd does not expand $HOME or ~ in EnvironmentFile: use absolute paths there.
EnvironmentFile=%h/.config/claude-mattermost/bot.env
ExecStart=%h/.local/bin/claude-mattermost-bridge
# The bridge reconnects to the app server and to Mattermost by itself, so a
# server restart does not need a bridge restart.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
