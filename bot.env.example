# Copy to bot.env (mode 600). Works with `set -a; . bot.env` and systemd EnvironmentFile.
MM_URL=https://mattermost.example.com
# Bot account access token (System Console > Integrations > Bot Accounts), mode 600
MM_TOKEN_FILE=/home/uranix/.config/claude-mattermost/token
# Comma-separated usernames allowed to talk to the bot; empty is refused at startup
MM_ALLOWED_USERS=uranix
# 1 = also answer @mentions in channels and group DMs (one Claude thread per Mattermost thread)
MM_ALLOW_CHANNELS=0

# claude-app-server address; the key comes from APP_SERVER_KEY_FILE
APP_SERVER_URL=ws://127.0.0.1:3284
# The key is read from this file and appended as ?key= (the app server creates it on first start).
APP_SERVER_KEY_FILE=/home/uranix/.config/claude-mattermost/app-server.key
CLAUDE_CWD=/home/uranix/chat
# default | plan | acceptEdits | dontAsk | bypassPermissions (last needs a server flag)
CLAUDE_PERMISSION_MODE=acceptEdits
# Initial model for new conversations (e.g. opus, or a full ID); users change it with !model
# CLAUDE_MODEL=opus

# Conversation -> Claude session map, lets contexts survive restarts ("" disables)
BRIDGE_STATE_FILE=/home/uranix/chat/bridge-state.json

# Close a conversation's server thread after this much inactivity (e.g. 90m, 0 = never).
# The next message resumes it, so this only frees server resources.
# BRIDGE_IDLE_CLOSE=1h

# Ask in chat (reactions or !allow/!deny) before tools that need permission run; 0 = refuse silently
# BRIDGE_PERMISSION_PROMPTS=1
# Too many prompts? Users can run !trust Bash, or !mode auto; CLAUDE_PERMISSION_MODE=auto makes it the default.

# Let Claude send files/images back: standalone markdown links/images in its replies are
# uploaded. Allowed sources: CLAUDE_CWD, the attachment dir, /tmp, and BRIDGE_SEND_ROOTS.
# BRIDGE_SEND_FILES=1
# BRIDGE_SEND_ROOTS=/home/uranix/reports,/data/out

# Incoming attachments are saved here; the app server must read the same paths
BRIDGE_ATTACHMENT_DIR=/home/uranix/chat/attachments
# BRIDGE_MAX_FILE_MB=50
# 1 = post a one-line note for every tool call
BRIDGE_SHOW_TOOLS=0
BRIDGE_DEBUG=0
